<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <add name="X-Powered-By" value="" />
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer-when-downgrade" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=*, clipboard-write=*" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="31457280" />
        <denyUrlSequences>
          <add sequence="config.php" />
          <add sequence="security.php" />
          <add sequence="router.php" />
          <add sequence=".env" />
          <add sequence=".state/" />
          <add sequence="logs/" />
          <add sequence="/.state" />
          <add sequence="/logs" />
          <add sequence="blocked_bots.log" />
          <add sequence="telegram_errors.log" />
          <add sequence="banned_ips.json" />
          <add sequence="cb_" />
        </denyUrlSequences>
        <hiddenSegments applyToWebDAV="false">
          <add segment=".state" />
          <add segment="logs" />
          <add segment=".git" />
          <add segment=".github" />
        </hiddenSegments>
        <fileExtensions applyToWebDAV="false">
          <add fileExtension=".json" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".txt" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <handlers>
      <add name="PHP via FastCGI"
           path="*.php"
           verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\Program Files (x86)\PHP\v8.1\php-cgi.exe"
           resourceType="Either"
           allowPathInfo="true" />
    </handlers>

    <staticContent>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <clientCache cacheControlMaxAge="7.00:00:00" cacheControlMode="UseMaxAge" />
    </staticContent>

    <rewrite>
      <rules>
        <clear />
        <rule name="Bloquear acceso directo a carpetas sensibles (.state y logs)" stopProcessing="true">
          <match url="^(\.state|logs)(/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <rule name="Bloquear acceso directo a archivos sensibles" stopProcessing="true">
          <match url="^(config|security|router|test-api)\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>

        <rule name="Redirigir HTTP a HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{WARMUP_REQUEST}" pattern="1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <rule name="Rutas amigables (si no existe archivo ni carpeta)" stopProcessing="true">
          <match url="^(.*)$" ignoreCase="false" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{URL}" pattern="^/api\.php(.*)$" ignoreCase="true" negate="true" />
            <add input="{URL}" pattern="^/webhook\.php(.*)$" ignoreCase="true" negate="true" />
            <add input="{URL}" pattern="^/(assets|vendor|storage|images)(.*)$" ignoreCase="true" negate="true" />
            <add input="{URL}" pattern="^/[a-z0-9_-]+\.php(.*)$" ignoreCase="true" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="403" />
      <remove statusCode="404" />
      <error statusCode="403" path="/" responseMode="ExecuteURL" />
      <error statusCode="404" path="/" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>

  <appSettings>
    <add key="PHP_MAX_UPLOAD" value="30M" />
    <add key="PHP_MEMORY_LIMIT" value="256M" />
    <add key="PHP_MAX_EXECUTION_TIME" value="120" />
  </appSettings>
</configuration>
